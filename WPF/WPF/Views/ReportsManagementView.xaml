<Window x:Class="WPF.Views.ReportsManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление жалобами" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Фильтр по статусу: " 
                       VerticalAlignment="Center" 
                       Margin="0,0,10,0"/>
            <ComboBox ItemsSource="{Binding StatusFilters}" 
                      SelectedItem="{Binding StatusFilter}"
                      Width="150"
                      Margin="0,0,20,0"/>
            <Button Content="Обновить" 
                    Command="{Binding RefreshCommand}" 
                    Width="100" 
                    Height="30"
                    Background="#2196F3"
                    Foreground="White"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    BorderBrush="#E0E0E0" 
                    BorderThickness="1" 
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Список жалоб" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Padding="10"
                               Background="#F5F5F5"/>

                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding Reports}" 
                             SelectedItem="{Binding SelectedReport, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ReportTitle}" 
                                                   FontSize="14" 
                                                   FontWeight="Bold"/>
                                        <TextBlock FontSize="12" Foreground="#757575" Margin="0,5,0,0">
                                            <Run Text="От: "/>
                                            <Run Text="{Binding Reporter.Name}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Reporter.Surname}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="#757575" Margin="0,2,0,0">
                                            <Run Text="На: "/>
                                            <Run Text="{Binding ReportedUser.Name}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding ReportedUser.Surname}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Status}" 
                                                   FontSize="12" 
                                                   Foreground="#FF9800" 
                                                   Margin="0,5,0,0"/>
                                        <TextBlock FontSize="11" Foreground="#9E9E9E" Margin="0,2,0,0">
                                            <Run Text="{Binding SentAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" 
                    BorderBrush="#E0E0E0" 
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Детали жалобы" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Padding="10"
                               Background="#F5F5F5"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Нет выбранной жалобы" 
                                       FontSize="14" 
                                       Foreground="#9E9E9E"
                                       Visibility="{Binding SelectedReport, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}"/>

                            <StackPanel Visibility="{Binding SelectedReport, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="{Binding SelectedReport.ReportTitle}" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Margin="0,0,0,15"/>

                                <TextBlock FontSize="14" Margin="0,0,0,10">
                                    <Run Text="Статус: " FontWeight="Bold"/>
                                    <Run Text="{Binding SelectedReport.Status}" Foreground="#FF9800"/>
                                </TextBlock>

                                <TextBlock FontSize="14" Margin="0,0,0,10">
                                    <Run Text="Подал жалобу: " FontWeight="Bold"/>
                                    <Run Text="{Binding SelectedReport.Reporter.Name}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding SelectedReport.Reporter.Surname}"/>
                                    <Run Text=" ("/>
                                    <Run Text="{Binding SelectedReport.Reporter.Email}"/>
                                    <Run Text=")"/>
                                </TextBlock>

                                <TextBlock FontSize="14" Margin="0,0,0,10">
                                    <Run Text="На пользователя: " FontWeight="Bold"/>
                                    <Run Text="{Binding SelectedReport.ReportedUser.Name}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding SelectedReport.ReportedUser.Surname}"/>
                                    <Run Text=" ("/>
                                    <Run Text="{Binding SelectedReport.ReportedUser.Email}"/>
                                    <Run Text=")"/>
                                </TextBlock>

                                <TextBlock FontSize="14" Margin="0,0,0,10" 
                                           Visibility="{Binding SelectedReport.Item, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Run Text="Связанное объявление: " FontWeight="Bold"/>
                                    <Run Text="{Binding SelectedReport.Item.ItemTitle}" Foreground="#2196F3"/>
                                </TextBlock>

                                <TextBlock FontSize="14" Margin="0,0,0,10">
                                    <Run Text="Дата подачи: " FontWeight="Bold"/>
                                    <Run Text="{Binding SelectedReport.SentAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"/>
                                </TextBlock>

                                <TextBlock FontSize="14" Margin="0,0,0,10"
                                           Visibility="{Binding SelectedReport.ResolvedAt, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Run Text="Дата решения: " FontWeight="Bold"/>
                                    <Run Text="{Binding SelectedReport.ResolvedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"/>
                                </TextBlock>

                                <TextBlock Text="Описание:" 
                                           FontSize="14" 
                                           FontWeight="Bold" 
                                           Margin="0,15,0,5"/>
                                <Border BorderBrush="#E0E0E0" 
                                        BorderThickness="1" 
                                        Padding="10" 
                                        Background="#FAFAFA"
                                        Margin="0,0,0,15">
                                    <TextBlock Text="{Binding SelectedReport.Description}" 
                                               TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="Вложения:" 
                                           FontSize="14" 
                                           FontWeight="Bold" 
                                           Margin="0,0,0,5"
                                           Visibility="{Binding SelectedReport.AttachmentsPath, Converter={StaticResource StringToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding SelectedReport.AttachmentsPath}" 
                                           FontSize="12" 
                                           Foreground="#757575"
                                           Margin="0,0,0,15"
                                           Visibility="{Binding SelectedReport.AttachmentsPath, Converter={StaticResource StringToVisibilityConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" 
                            BorderBrush="#E0E0E0" 
                            BorderThickness="0,1,0,0" 
                            Background="#F5F5F5" 
                            Padding="15">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Заблокировать пользователя" 
                                    Command="{Binding BlockUserCommand}" 
                                    Width="200" 
                                    Height="35"
                                    Background="#F44336"
                                    Foreground="White"
                                    Margin="0,0,10,0"/>
                            <Button Content="Редактировать объявление" 
                                    Command="{Binding EditItemCommand}" 
                                    Width="180" 
                                    Height="35"
                                    Background="#2196F3"
                                    Foreground="White"
                                    Margin="0,0,10,0"/>
                            <Button Content="Удалить объявление" 
                                    Command="{Binding DeleteItemCommand}" 
                                    Width="160" 
                                    Height="35"
                                    Background="#FF5722"
                                    Foreground="White"
                                    Margin="0,0,10,0"/>
                            <Button Content="Закрыть жалобу" 
                                    Command="{Binding ResolveReportCommand}" 
                                    Width="140" 
                                    Height="35"
                                    Background="#4CAF50"
                                    Foreground="White"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

