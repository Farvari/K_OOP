<Window x:Class="WPF.Views.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Регистрация" Height="594" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="30,30,30,11">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Регистрация" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Email:" FontSize="14" Margin="0,0,0,5"/>
        <TextBox Grid.Row="2" 
                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                 FontSize="14" 
                 Padding="5" 
                 Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Text="Пароль:" FontSize="14" Margin="0,0,0,5"/>
        <PasswordBox x:Name="PasswordBox" 
                     Grid.Row="4" 
                     FontSize="14" 
                     Padding="5" 
                     Margin="0,0,0,10"
                     PasswordChanged="PasswordBox_PasswordChanged"/>

        <TextBlock Grid.Row="5" Text="Подтвердите пароль:" FontSize="14" Margin="0,0,0,5"/>
        <PasswordBox x:Name="ConfirmPasswordBox" 
                     Grid.Row="6" 
                     FontSize="14" 
                     Padding="5" 
                     Margin="0,0,0,10"
                     PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>

        <TextBlock Grid.Row="7" Text="Имя:" FontSize="14" Margin="0,0,0,5"/>
        <TextBox Grid.Row="8" 
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                 FontSize="14" 
                 Padding="5" 
                 Margin="0,0,0,10"/>

        <TextBlock Grid.Row="9" Text="Фамилия:" FontSize="14" Margin="0,0,0,5"/>
        <TextBox Grid.Row="10" 
                 Text="{Binding Surname, UpdateSourceTrigger=PropertyChanged}" 
                 FontSize="14" 
                 Padding="5" 
                 Margin="0,0,0,10"/>

        <TextBlock Grid.Row="11" FontSize="14" Margin="0,0,0,5"><Run Text="Телефон (+"/><Run Language="ru-ru" Text="375123456789"/><Run Text="):"/></TextBlock>
        <TextBox Grid.Row="12" 
                 Text="{Binding PhoneNum, UpdateSourceTrigger=PropertyChanged}" 
                 FontSize="14" 
                 Padding="5" 
                 Margin="0,0,0,15"/>

        <TextBlock Grid.Row="13" 
                   Text="{Binding ErrorMessage}" 
                   Foreground="Red" 
                   FontSize="12" 
                   TextWrapping="Wrap" 
                   Margin="0,0,0,15"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

        <StackPanel Grid.Row="14" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center">
            <Button Content="Зарегистрироваться" 
                    Command="{Binding RegisterCommand}" 
                    Width="150" 
                    Height="35" 
                    Margin="0,0,10,0"
                    FontSize="14"/>
            <Button Content="Отмена" 
                    Command="{Binding CancelCommand}" 
                    Width="100" 
                    Height="35"
                    FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>

