<Window x:Class="WPF.Views.ItemDetailsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Детали объявления" Height="700" Width="900"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="{Binding Item.ItemTitle}" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   TextWrapping="Wrap"
                   Margin="0,0,0,15"/>

            <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    Margin="0,0,0,10">
                <TextBlock Text="Категория: " 
                       FontSize="14" 
                       Foreground="#757575"/>
                <TextBlock Text="{Binding Item.Category}" 
                       FontSize="14" 
                       FontWeight="SemiBold"/>
            </StackPanel>

            <TextBlock Grid.Row="3" 
                   Text="{Binding Item.Price, StringFormat='{}{0:N0} р.'}" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Foreground="#4CAF50"
                   Margin="0,0,0,15"/>

        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="" 
                       FontSize="16" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Item.Images.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Item.Images, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" 
                        Content="◀" 
                        Command="{Binding PreviousImageCommand}"
                        Width="50" 
                        Height="50"
                        FontSize="24"
                        Background="#E0E0E0"
                        Foreground="#333"
                        BorderThickness="1"
                        BorderBrush="#BDBDBD"
                        Cursor="Hand"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="{Binding CanGoToPrevious}"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Border Grid.Column="1" 
                        BorderBrush="#E0E0E0" 
                        BorderThickness="1" 
                        Background="White"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MinHeight="400"
                        MinWidth="400">
                    <Image Source="{Binding CurrentImage.ImgPath, Converter={StaticResource ImagePathConverter}}"
                           Stretch="Uniform"
                           MaxHeight="500"
                           MaxWidth="500"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentImage.ImgPath, Converter={StaticResource ImagePathConverter}}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Border>
                
                <Button Grid.Column="2" 
                        Content="▶" 
                        Command="{Binding NextImageCommand}"
                        Width="50" 
                        Height="50"
                        FontSize="24"
                        Background="#E0E0E0"
                        Foreground="#333"
                        BorderThickness="1"
                        BorderBrush="#BDBDBD"
                        Cursor="Hand"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="{Binding CanGoToNext}"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            
            <TextBlock Text="{Binding ImageCounter}" 
                       FontSize="14" 
                       Foreground="#757575"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Item.Images.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Item.Images, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="5">
            <TextBlock Text="Описание:" 
                       FontSize="16" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,10"/>
            <TextBlock Text="{Binding Item.Description}" 
                       FontSize="14" 
                       TextWrapping="Wrap" 
                       Margin="0,0,0,15"/>
        </StackPanel>

        <StackPanel Grid.Row="6">
            <TextBlock Text="Контактная информация:" 
                       FontSize="14" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,5"/>
            <TextBlock Text="{Binding Item.ContactInfo}" 
                       FontSize="14" 
                       Margin="0,0,0,10"/>

            <TextBlock Text="Продавец:" 
                       FontSize="14" 
                       FontWeight="SemiBold" 
                       Margin="0,10,0,5"/>
            <TextBlock FontSize="14" 
                       Margin="0,0,0,5">
                <Run Text="{Binding Item.User.Name}"/>
                <Run Text="{Binding Item.User.Surname}"/>
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Рейтинг: " 
                           FontSize="14" 
                           FontWeight="SemiBold"/>
                <TextBlock FontSize="14" 
                           Foreground="#FF9800"
                           FontWeight="Bold">
                    <TextBlock.Text>
                        <Binding Path="Item.User.Rating" StringFormat="{}{0:F2}">
                            <Binding.TargetNullValue>
                                <sys:String>Нет оценок</sys:String>
                            </Binding.TargetNullValue>
                        </Binding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>

            <TextBlock Text="Дата создания:" 
                       FontSize="14" 
                       FontWeight="SemiBold" 
                       Margin="0,10,0,5"/>
            <TextBlock Text="{Binding Item.CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" 
                       FontSize="14"
                       Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="В избранное" 
                        Command="{Binding AddToFavoriteCommand}" 
                        Width="120" 
                        Height="35"
                        Background="#FF9800"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,10,0"/>
                <Button Content="Оценить продавца" 
                        Command="{Binding RateSellerCommand}" 
                        Width="150" 
                        Height="35"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,10,0"/>
                <Button Content="Пожаловаться" 
                        Command="{Binding ReportSellerCommand}" 
                        Width="120" 
                        Height="35"
                        Background="#F44336"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,10,0"/>
                <Button Content="Редактировать" 
                        Command="{Binding EditItemCommand}" 
                        Width="130" 
                        Height="35"
                        Background="#9C27B0"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>

