<Window x:Class="WPF.Views.AddEditItemView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить объявление" Height="550" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Название:" FontSize="14" Margin="0,0,0,5"/>
        <TextBox Grid.Row="1" Text="{Binding ItemTitle}" FontSize="14" Padding="5" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Text="Описание:" FontSize="14" Margin="0,0,0,5"/>
        <TextBox Grid.Row="3" Text="{Binding Description}" FontSize="14" Padding="5" 
                 TextWrapping="Wrap" AcceptsReturn="True" Height="80" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" Text="Категория:" FontSize="14" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="5" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" 
                  IsEditable="True" FontSize="14" Padding="5" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="6" Text="Цена (р.):" FontSize="14" Margin="0,0,0,5"/>
        <TextBox Grid.Row="7" Text="{Binding Price}" FontSize="14" Padding="5" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="8" Text="Контактная информация:" FontSize="14" Margin="0,0,0,5"/>
        <TextBox Grid.Row="9" Text="{Binding ContactInfo}" FontSize="14" Padding="5" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="10" Text="Статус:" FontSize="14" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="11" ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" 
                  FontSize="14" Padding="5" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="100" Height="35" 
                    Background="#4CAF50" Foreground="White" Margin="0,0,10,0"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" Width="100" Height="35"/>
        </StackPanel>
    </Grid>
</Window>

