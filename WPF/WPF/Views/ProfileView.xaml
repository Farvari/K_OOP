<Window x:Class="WPF.Views.ProfileView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мой профиль" Height="610" Width="450"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Мой профиль" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Email:" FontSize="14" Margin="0,0,0,5"/>
        <TextBox Grid.Row="2" Text="{Binding Email}" FontSize="14" Padding="5" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Text="Имя:" FontSize="14" Margin="0,0,0,5"/>
        <TextBox Grid.Row="4" Text="{Binding Name}" FontSize="14" Padding="5" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="5" Text="Фамилия:" FontSize="14" Margin="0,0,0,5"/>
        <TextBox Grid.Row="6" Text="{Binding Surname}" FontSize="14" Padding="5" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="7" Text="Телефон:" FontSize="14" Margin="0,0,0,5"/>
        <TextBox Grid.Row="8" Text="{Binding PhoneNum}" FontSize="14" Padding="5" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="9" Text="Рейтинг:" FontSize="14" Margin="0,0,0,5"/>
        <TextBlock Grid.Row="10" Text="{Binding Rating}" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="11" Text="Новый пароль (оставьте пустым, чтобы не менять):" FontSize="14" Margin="0,0,0,5"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="12" FontSize="14" Padding="5" Margin="0,0,0,10"
                     PasswordChanged="PasswordBox_PasswordChanged"/>

        <TextBlock Grid.Row="13" Text="Подтвердите пароль:" FontSize="14" Margin="0,0,0,5"/>
        <PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="14" FontSize="14" Padding="5" Margin="0,0,0,15"
                     PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>

        <StackPanel Grid.Row="15" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="100" Height="35" 
                    Background="#4CAF50" Foreground="White" Margin="0,0,10,0"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" Width="100" Height="35"/>
        </StackPanel>
    </Grid>
</Window>

