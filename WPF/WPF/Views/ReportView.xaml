<Window x:Class="WPF.Views.ReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пожаловаться на продавца" Height="500" Width="550"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="18" FontWeight="Bold" Margin="0,0,0,20">
            <Run Text="Жалоба на продавца"/>
        </TextBlock>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Продавец: " FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ReportedUserName}" FontSize="14" Foreground="#F44336"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Объявление:" FontSize="12" Foreground="#757575" Margin="0,0,0,5" 
                   Visibility="{Binding ReportedItemTitle, Converter={StaticResource StringToVisibilityConverter}}"/>
        <TextBlock Grid.Row="3" Text="{Binding ReportedItemTitle}" FontSize="12" FontStyle="Italic" 
                   Foreground="#757575" Margin="0,0,0,15"
                   Visibility="{Binding ReportedItemTitle, Converter={StaticResource StringToVisibilityConverter}}"/>

        <TextBlock Grid.Row="4" Text="Название жалобы:" FontSize="14" Margin="0,0,0,5"/>
        <TextBox Grid.Row="5" Text="{Binding ReportTitle, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="5" Margin="0,0,0,15" MaxLength="60"/>

        <TextBlock Grid.Row="6" Text="Описание:" FontSize="14" Margin="0,0,0,5"/>
        <TextBox Grid.Row="7" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="5" 
                 TextWrapping="Wrap" AcceptsReturn="True" Height="100" Margin="0,0,0,15" MaxLength="500"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отправить" Command="{Binding SaveCommand}" Width="100" Height="35" 
                    Background="#F44336" Foreground="White" Margin="0,0,10,0"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" Width="100" Height="35"/>
        </StackPanel>
    </Grid>
</Window>

