<Window x:Class="WPF.Views.FavoritesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Избранные объявления" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="Удалить из избранного" 
                    Command="{Binding RemoveFromFavoritesCommand}" 
                    Width="180" 
                    Height="35"
                    Background="#F44336"
                    Foreground="White"
                    Margin="0,0,10,0"/>
            <Button Content="Обновить" 
                    Command="{Binding RefreshCommand}" 
                    Width="100" 
                    Height="35"
                    Background="#4CAF50"
                    Foreground="White"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    BorderBrush="#BDBDBD" 
                    BorderThickness="1" 
                    Margin="0,0,10,0">
                <ListBox ItemsSource="{Binding FavoriteItems}" 
                         SelectedItem="{Binding SelectedItem}" 
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E0E0E0" 
                                    BorderThickness="0,0,0,1" 
                                    Padding="15" 
                                    Margin="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" 
                                               Text="{Binding ItemTitle}" 
                                               FontSize="16" 
                                               FontWeight="Bold" 
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,5"/>

                                    <TextBlock Grid.Row="1" 
                                               Text="{Binding Category}" 
                                               FontSize="12" 
                                               Foreground="#757575"
                                               Margin="0,0,0,5"/>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <TextBlock Text="Цена: " 
                                                   FontSize="14" 
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Price, StringFormat='{}{0:N0} р.'}" 
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Foreground="#4CAF50"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1" 
                    BorderBrush="#BDBDBD" 
                    BorderThickness="1" 
                    Background="White">
                <Grid>
                    <TextBlock Text="Выберите объявление для просмотра деталей" 
                               FontSize="16" 
                               Foreground="#9E9E9E" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" 
                                       Text="{Binding SelectedItem.ItemTitle}" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,15"/>

                            <StackPanel Grid.Row="1" 
                                        Orientation="Horizontal" 
                                        Margin="0,0,0,10">
                                <TextBlock Text="Категория: " 
                                           FontSize="14" 
                                           Foreground="#757575"/>
                                <TextBlock Text="{Binding SelectedItem.Category}" 
                                           FontSize="14" 
                                           FontWeight="SemiBold"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" 
                                       Text="Цена:" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="#4CAF50"
                                       Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="3" 
                                       Text="{Binding SelectedItem.Price, StringFormat='{}{0:N0} р.'}" 
                                       FontSize="20" 
                                       FontWeight="Bold" 
                                       Foreground="#4CAF50"
                                       Margin="0,0,0,15"/>

                            <TextBlock Grid.Row="4" 
                                       Text="Описание:" 
                                       FontSize="16" 
                                       FontWeight="SemiBold" 
                                       Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="5" 
                                       Text="{Binding SelectedItem.Description}" 
                                       FontSize="14" 
                                       TextWrapping="Wrap" 
                                       Margin="0,0,0,15"/>

                            <StackPanel Grid.Row="6">
                                <TextBlock Text="Контактная информация:" 
                                           FontSize="14" 
                                           FontWeight="SemiBold" 
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding SelectedItem.ContactInfo}" 
                                           FontSize="14" 
                                           Margin="0,0,0,10"/>

                                <TextBlock Text="Продавец:" 
                                           FontSize="14" 
                                           FontWeight="SemiBold" 
                                           Margin="0,10,0,5"/>
                                <TextBlock FontSize="14" 
                                           Margin="0,0,0,10">
                                    <Run Text="{Binding SelectedItem.User.Name}"/>
                                    <Run Text="{Binding SelectedItem.User.Surname}"/>
                                </TextBlock>

                                <TextBlock Text="Дата создания:" 
                                           FontSize="14" 
                                           FontWeight="SemiBold" 
                                           Margin="0,10,0,5"/>
                                <TextBlock Text="{Binding SelectedItem.CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" 
                                           FontSize="14"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

